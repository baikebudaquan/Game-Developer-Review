---
const { slug = 'brand' } = Astro.props;
const glyphs: Record<string, string[]> = {
  brand: ['000000000000','000110011000','001111111100','011011110110','111001101111','111011110011','111111111111','111100001111','011000000110','000000000000'],
  cloudcape: ['0000000000','0000000100','0001000000','0011100100','0111111110','0110111110','1100011011','1111111111','0000000000','0000000000'],
  wovenfield: ['0000000000','0000000110','0001101110','0001111100','0110110000','0011110110','0001111100','0001100000','0011000000','0000000000'],
  glowharbor: ['0000110000','0001111000','0011111100','0001001000','0001111000','0000110000','0001111000','0001111000','0011111100','0111111110'],
  sandisle: ['0000000000','0000110000','0001111000','0011111100','0111001110','1110000111','0111001110','0011111100','0001111000','0000110000'],
};
const pattern = glyphs[slug] || glyphs.sandisle;
const dots = pattern.flatMap((row,y) => [...row].flatMap((bit,x) => bit === '1' ? [`${x}em ${y}em currentColor`] : []));
---
<span class:list={['mark', 'mark-' + (Object.hasOwn(glyphs,slug) ? slug : 'sandisle')]} aria-hidden="true">
  <i style={`width:${pattern[0].length}em;height:${pattern.length}em`}><b style={{boxShadow:dots.join(',')}}></b></i>
</span>
