---
import ProjectCover from './ProjectCover.astro';
import ReviewRating from './ReviewRating.astro';
import type { Project } from '../lib/projects';
interface Props { project: Project; inStudio?: boolean; showRating?: boolean; recommended?: boolean }
const {project:p, inStudio=false, showRating=true, recommended} = Astro.props;
---
<a class="project-tile" href={p.path} data-project={p.search} data-pick={recommended ? 'true' : undefined} hidden={recommended===false}>
  <span class="tile-frame"><ProjectCover project={p}/>
    {p.reviews[0] && <span class="tile-peek"><small>最近评价</small><span>{p.reviews[0].title || p.reviews[0].comment}</span><b>查看全部评价 →</b></span>}
  </span>
  <div class="tile-body"><small>{inStudio ? p.status : p.company}</small>
    <div class="tile-title-row"><h3>{p.name}</h3>{showRating && <ReviewRating rating={p}/>}</div>
  </div>
</a>
