---
import ProjectCover from './ProjectCover.astro';
import ReviewRating from './ReviewRating.astro';
import type { Project } from '../lib/projects';
interface Props { project: Project; inStudio?: boolean; recommended?: boolean }
const {project:p, inStudio=false, recommended} = Astro.props;
---
<a class="project-tile" href={p.path} data-project={p.search} data-pick={recommended ? 'true' : undefined} hidden={recommended===false}>
  <span class="tile-frame"><ProjectCover project={p} src={recommended ? p.scene : undefined}/>
    {p.reviews[0] && <span class="tile-peek"><small>最近评价</small><span>{p.reviews[0].title || p.reviews[0].comment}</span><b>查看全部评价 →</b></span>}
  </span>
  <div class="tile-body"><small>{inStudio ? p.status : p.company}{recommended && <span class="board-status" data-status={p.statusKey}>{p.status}</span>}</small>
    <div class="tile-title-row"><h3>{p.name}</h3><ReviewRating rating={p}/></div>
    {recommended && <dl class="board-stats">
      <div><dt>近 30 天好评</dt><dd>{p.recentPositive}<small> 篇</small></dd></div>
      <div><dt>累计好评率</dt><dd>{Math.round(p.ratio * 100)}<small>%</small></dd></div>
    </dl>}
  </div>
</a>
