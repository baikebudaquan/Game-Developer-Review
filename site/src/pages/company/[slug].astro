---
import Layout from '../../components/Layout.astro';
import Mark from '../../components/Mark.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { detail, index, href, taxonomy, scoreText, label } from '../../lib/data';
import type { ProfileKey } from '../../lib/data';
export function getStaticPaths() {
  return index.companies.map(c => ({ params: { slug: c.slug }, props: { data: detail(c.id) } }));
}
const { company, projects, byProfile, reviews } = Astro.props.data;
const ordered = [...reviews].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt));
const visibleStats = company.reviewCount >= 3;
const dimensions = [
  ['role','岗位',taxonomy.roles], ['tenure','司龄',taxonomy.tenures],
  ['employment','在职状态',taxonomy.employments], ['city','城市',taxonomy.cities],
] as const;
const groups = dimensions.flatMap(([key,title,items])=>(byProfile?.[key] || [])
  .filter(cell=>cell.count>=3).map(cell=>({...cell,title,text:label(items,cell.key)})));
const filterItems = (key:ProfileKey) => new Set(reviews.map(r=>r.profile?.[key]).filter(Boolean));
const roles = filterItems('role'), tenures = filterItems('tenure');
const statuses:Record<string,string> = {live:'已上线',dev:'在研',cancelled:'已取消',unknown:'状态未知'};
---
<Layout title={company.name}>
  <nav class="crumb" aria-label="面包屑"><a href={href('companies/')}>公司目录</a><span> / </span>{company.name}</nav>
  <section class="identity panel">
    <Mark slug={company.slug}/><div><h1>{company.name}</h1>{company.aliases?.length > 0 && <p>{company.aliases.join(' · ')}</p>}</div>
    <div class="big-score"><span>综合评分</span><strong>{scoreText(company.avgScore)}<small> / 5</small></strong><span>{company.reviewCount} 条评价</span></div>
  </section>
  <div class="detail-columns">
    <aside class="overview">
      <section class="panel side-panel"><h2>项目概览</h2>
        {projects.length===0 && <p class="muted">暂无收录项目</p>}
        {projects.map(p=><div class="project-row"><b>{p.name}</b><small>{statuses[p.status] || '状态未知'}{visibleStats && ` · ${p.reviewCount} 条评价 · ${scoreText(p.avgScore)} 分`}</small></div>)}
      </section>
      {visibleStats && <section class="panel side-panel"><h2>评分分布</h2>{[5,4,3,2,1].map(n=><div class="bar-row"><span>{n} 星</span><div class="track"><i style={{width:(company.scoreDistribution[n] || 0)/company.reviewCount*100+'%'}}></i></div><b>{company.scoreDistribution[n] || 0}</b></div>)}</section>}
      {visibleStats && groups.length>0 && <section class="panel side-panel"><h2>画像统计</h2>{groups.map(g=><div class="group-row"><span>{g.title} · {g.text}</span><small>{g.count} 条 · 均分 {scoreText(g.avgScore)}</small></div>)}</section>}
    </aside>
    <section class="review-section">
      <div class="section-title"><div><h2>开发者评价</h2><span id="matches" class="total" aria-live="polite">{reviews.length}</span></div></div>
      <div class="filters">
        <label>项目<select id="project"><option value="">全部项目</option>{projects.map(p=><option value={p.id}>{p.name}</option>)}</select></label>
        <label>岗位<select id="role"><option value="">全部岗位</option>{taxonomy.roles.filter(x=>roles.has(x.key)).map(x=><option value={x.key}>{x.label}</option>)}</select></label>
        <label>司龄<select id="tenure"><option value="">全部司龄</option>{taxonomy.tenures.filter(x=>tenures.has(x.key)).map(x=><option value={x.key}>{x.label}</option>)}</select></label>
      </div>
      <div class="reviews">
        {ordered.map(r=><ReviewCard review={r} projectName={projects.find(p=>p.id===r.projectId)?.name}/>)}
      </div>
      <div class="empty" id="no-reviews" hidden={reviews.length>0}><strong>{reviews.length ? '没有符合这些条件的评价' : '暂无公开评价'}</strong>{reviews.length>0 && <button id="reset" type="button">清除筛选</button>}</div>
    </section>
  </div>
</Layout>
<script>
  const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('.filters select'));
  const reviews = Array.from(document.querySelectorAll<HTMLElement>('.review'));
  function applyFilters() {
    let count = 0;
    reviews.forEach(r => {
      r.hidden = selects.some(s => s.value && r.dataset[s.id] !== s.value);
      if (!r.hidden) count++;
    });
    document.querySelector('#matches')!.textContent = String(count);
    document.querySelector<HTMLElement>('#no-reviews')!.hidden = count > 0;
  }
  selects.forEach(s => s.addEventListener('change', applyFilters));
  document.querySelector('#reset')?.addEventListener('click', () => {
    selects.forEach(s => { s.value=''; }); applyFilters(); selects[0].focus();
  });
  applyFilters();
</script>
