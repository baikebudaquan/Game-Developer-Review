---
import Layout from '../components/Layout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import DiscoverySearch from '../components/DiscoverySearch.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import { projects, asOf } from '../lib/projects';
import { index, href } from '../lib/data';
---
<Layout title="项目发现" active="projects" dark>
  <div class="discover-home" data-arcade-url={href('arcade/#arcade-title')}>
    <header class="discovery-intro"><div><h1>项目发现</h1><p>{index.totals.companies} 家公司 <span>·</span> {projects.length} 个游戏项目</p></div><DiscoverySearch/></header>
    <FeaturedProjects/>
    <section id="projects" class="project-library" aria-labelledby="library-title">
      <div class="discovery-section-head"><h2 id="library-title"><i aria-hidden="true"></i><span data-library-title>全部项目</span><small data-result-count>{projects.length}</small></h2>
      <details class="ranking-rule"><summary>近期好评最多 ⓘ</summary><p>以 {asOf} 的数据为准，统计近 30 个自然日内的 4、5 星评价。同数时依次比较累计好评数、总评价数和最近评价日期。等级按全部评价的好评比例及样本量换算。</p></details></div>
      <div class="project-grid">
        {projects.map(p=><ProjectTile project={p}/>)}
      </div>
      {projects.length === 0 && <div class="project-empty"><h3>还没有已发布的评价</h3><p>审核通过后会出现在这里。</p></div>}
      <div class="project-empty" data-empty hidden><h3>没有找到匹配的项目</h3><button type="button" data-reset>查看全部项目</button></div>
      <p class="sr" role="status" data-search-status></p>
    </section>
  </div>
</Layout>
<script>
  import { setupDiscovery } from '../lib/discovery-ui';
  setupDiscovery();
</script>
