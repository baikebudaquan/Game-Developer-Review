---
import Layout from '../components/Layout.astro';
import Mark from '../components/Mark.astro';
import { href, index, detail, taxonomy, label, month, scoreText } from '../lib/data';
const sorted = index.companies.map(c => ({
  ...c, aliases: c.aliases ?? detail(c.id).company.aliases ?? [],
})).sort((a,b) => (b.avgScore ?? -1) - (a.avgScore ?? -1) || b.reviewCount-a.reviewCount || a.name.localeCompare(b.name,'zh-CN'));
---
<Layout title="游戏公司评价库">
  <section aria-labelledby="directory">
    <div class="section-title" style="margin-top:30px"><div><h1 id="directory">公司目录</h1><span class="total">{index.totals.companies}</span></div></div>
    <div class="toolbar">
      <label class="search"><i class="glass" aria-hidden="true"></i><input type="search" id="query" aria-label="搜索公司" placeholder="搜索公司名称或别名" autocomplete="off" /></label>
      <label class="sort">排序<select id="sort"><option value="score">综合评分</option><option value="count">评价数量</option><option value="recent">最近更新</option></select></label>
    </div>
    <div class="company-grid" id="companies">
      {sorted.map(c=><a class="company-card" href={href('company/' + c.slug + '/')}
        data-name={[c.name,c.slug,...(c.aliases || [])].join(' ')} data-score={c.avgScore ?? -1} data-count={c.reviewCount} data-recent={c.lastPublishedAt ?? ''}>
        <div class="card-top"><Mark slug={c.slug} /><div class="card-title"><h3>{c.name}</h3>{c.aliases?.[0] && <small>{c.aliases[0]}</small>}</div>
          <span class="rating" aria-label={'综合评分 ' + scoreText(c.avgScore)}><i>★</i>{scoreText(c.avgScore)}</span>
        </div>
        <div class="card-info"><span>{c.projectCount} 个项目</span><span>{c.reviewCount} 条评价</span>{c.lastPublishedAt && <span>{month(c.lastPublishedAt)} 更新</span>}</div>
        <div class="card-foot"><div class="chips">{c.topTags.slice(0,3).map(t=><span>{label(taxonomy.tags,t.key)}</span>)}</div><span class="go" aria-label="查看详情">↗</span></div>
      </a>)}
    </div>
    <p class="sr" role="status" id="results"></p>
    <div class="empty" id="no-results" hidden><strong>没有找到匹配的公司</strong><button type="button" id="clear-search">清空搜索</button></div>
  </section>
</Layout>
<script>
  const grid = document.querySelector<HTMLElement>('#companies')!;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.company-card'));
  const search = document.querySelector<HTMLInputElement>('#query')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  function refresh() {
    const needle = search.value.trim().toLocaleLowerCase();
    const ordered = [...cards].sort((a,b) => {
      if (sort.value === 'recent') return (b.dataset.recent || '').localeCompare(a.dataset.recent || '');
      const key = sort.value === 'count' ? 'count' : 'score';
      return Number(b.dataset[key]) - Number(a.dataset[key]);
    });
    let count = 0;
    for (const el of ordered) {
      el.hidden = !el.dataset.name!.toLocaleLowerCase().includes(needle);
      if (!el.hidden) count++;
      grid.append(el);
    }
    document.querySelector<HTMLElement>('.total')!.textContent = String(count);
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
    document.querySelector<HTMLElement>('#results')!.textContent = `共 ${count} 家公司`;
  }
  search.addEventListener('input', refresh);
  sort.addEventListener('change', refresh);
  document.querySelector('#clear-search')!.addEventListener('click', () => { search.value = ''; refresh(); search.focus(); });
  refresh();
</script>
